# Backend Environment Variables
NODE_ENV=development
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=gemogi
DB_PASSWORD=gemogi_password
DB_DATABASE=gemogi_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=your_access_secret_here_min_32_chars_change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars_change_me
JWT_REFRESH_EXPIRES_IN=7d

# Webhook Callback
CALLBACK_URL=http://localhost:3001/api/webhook/order-callback

# CORS
CORS_ORIGINS=http://localhost:3000
