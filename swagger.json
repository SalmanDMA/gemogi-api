        ]
      }
    },
    "/api/orders": {
      "post": {
        "operationId": "OrdersController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order successfully created and queued for processing."
          },
          "400": {
            "description": "Validation failed or invalid product ID."
          },
          "401": {
            "description": "Unauthorized access token."
          },
          "404": {
            "description": "Product not found or is inactive."
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Create a new order (returns PENDING immediately)",
        "tags": [
          "orders"
        ]
      },
      "get": {
        "operationId": "OrdersController_findAll",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Page number (default: 1)",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Number of items per page (default: 20)",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of orders retrieved successfully."
          },
          "401": {
            "description": "Unauthorized access token."
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Get all orders for current user (paginated)",
        "tags": [
          "orders"
        ]
      }
    },
    "/api/orders/{id}": {
      "get": {
        "operationId": "OrdersController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Order UUID",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order detail retrieved successfully."
          },
          "400": {
            "description": "Invalid UUID format."
          },
          "401": {
            "description": "Unauthorized access token."
          },
          "404": {
            "description": "Order not found."
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Get single order by ID for current user",
        "tags": [
          "orders"
        ]
      }
    },
