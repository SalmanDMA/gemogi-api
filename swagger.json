              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful. Returns access and refresh tokens."
          },
          "400": {
            "description": "Validation failed."
          },
          "401": {
            "description": "Invalid email or password."
          }
        },
        "summary": "Login with email and password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/refresh": {
